{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "search-api values",
  "type": "object",
  "required": ["replicas", "logLevel"],
  "properties": {
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Number of API pods. Zero is forbidden: search must always be served."
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "description": "Lower-case level names expected by the platform log pipeline."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" }
      }
    }
  }
}
